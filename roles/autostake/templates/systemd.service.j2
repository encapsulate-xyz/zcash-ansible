[Unit]
Description=Stake the {{ node_service_identifier }} wallet's free funds into bonds
After={{ node_service_identifier }}.service
Wants={{ node_service_identifier }}.service

[Service]
User={{ service_identifier }}
Group={{ service_identifier }}
WorkingDirectory={{ autostake_home_dir }}
ExecStart={{ autostake_script_file_path }}
Restart=on-failure
RestartSec=60
StandardOutput=append:{{ autostake_log_file_path }}
StandardError=inherit
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
